# LokroOS Plymouth Theme-Skript – dunkler Glass-Splash mit Logo + Fortschritt.
# Assets (logo.png, bar.png, box.png) werden reproduzierbar erzeugt, siehe
# branding/render-assets.py. Keine weiteren Abhaengigkeiten, nur ASCII.
# Konventionen: Hintergrund aus Tokens (#06090F -> #0B1B33), Cyan-Akzent,
# Fortschritt treibt Logo-Puls (kein Timer, robust auf jeder Hardware).

Window.SetBackgroundTopColor (0.024, 0.035, 0.059);
Window.SetBackgroundBottomColor (0.043, 0.106, 0.200);

logo.image = Image ("logo.png");
logo.sprite = Sprite (logo.image);
logo.x = Window.GetX () / 2 - logo.image.GetWidth () / 2;
logo.y = Window.GetY () / 2 - logo.image.GetHeight () / 2 - 40;
logo.sprite.SetPosition (logo.x, logo.y, 100);

box.image = Image ("box.png");
box.sprite = Sprite (box.image);
box.x = Window.GetX () / 2 - box.image.GetWidth () / 2;
box.y = logo.y + logo.image.GetHeight () + 48;
box.sprite.SetPosition (box.x, box.y, 100);

bar.image = Image ("bar.png");
bar.sprite = Sprite (bar.image);
bar.sprite.SetPosition (box.x, box.y, 101);
bar.sprite.SetClip (0, 0, 0, bar.image.GetHeight ());

# Statusmeldungen (z.B. LUKS-Passwort) zentriert in hellem Grau.
fun message_callback (text) {
  message.image = Image.Text (text, 0.95, 0.96, 0.98, "Sans 16");
  message.sprite = Sprite (message.image);
  message.x = Window.GetX () / 2 - message.image.GetWidth () / 2;
  message.y = box.y + 48;
  message.sprite.SetPosition (message.x, message.y, 100);
}

fun progress_callback (duration, progress) {
  if (progress > 1)
    progress = 1;
  bar.sprite.SetClip (0, 0, bar.image.GetWidth () * progress, bar.image.GetHeight ());
  logo.sprite.SetOpacity (0.72 + 0.28 * progress);
}

Plymouth.SetBootProgressFunction (progress_callback);
Plymouth.SetMessageFunction (message_callback);
